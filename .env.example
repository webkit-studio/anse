# Runtime připojení k DB — Supabase "Transaction pooler" (port 6543).
# Lokálně: postgres://anse:anse@localhost:5433/anse
DATABASE_URL=

# Migrace, seed a pg_dump — Supabase "Session pooler" (port 5432).
# Lokálně stejné jako DATABASE_URL.
DIRECT_DATABASE_URL=

# Podpis session JWT — min. 48 náhodných znaků (openssl rand -base64 48)
JWT_SECRET=

# Volitelné, jen pro první seed: bootstrap kód admina Lukáše (6 číslic,
# ne triviální). S ním se žádné kódy nevypisují do logů — zobrazí se v admin UI.
# SEED_ADMIN_CODE=

# E-mailové notifikace o změně stavu zakázky (Resend, free tier).
# Bez klíče se notifikace tiše přeskakují — appka funguje dál.
# Adresáti se nastavují v aplikaci: Správa účtů → Notifikace.
# RESEND_API_KEY=
# Odesílatel musí být na ověřené doméně v Resendu (jinak Resend odmítne).
# RESEND_FROM="Anse <zakazky@anse.cz>"
# Základ odkazů v e-mailu (jinak se bere origin požadavku).
# APP_URL=https://anse-zakazky.netlify.app
