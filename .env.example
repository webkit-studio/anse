# Runtime připojení k DB — Supabase "Transaction pooler" (port 6543).
# Lokálně: postgres://anse:anse@localhost:5433/anse
DATABASE_URL=

# Migrace, seed a pg_dump — Supabase "Session pooler" (port 5432).
# Lokálně stejné jako DATABASE_URL.
DIRECT_DATABASE_URL=

# Podpis session JWT — min. 48 náhodných znaků (openssl rand -base64 48)
JWT_SECRET=

# Po Milníku 1 (e-mail notifikace):
# RESEND_API_KEY=
