{
  "groups": [
    {
      "key": "zakladni",
      "label": "Základní údaje",
      "fields": [
        {
          "key": "sirka",
          "label": "Šířka",
          "type": "number",
          "unit": "mm",
          "required": true,
          "step": 1,
          "min": null,
          "max": null,
          "warnMin": null,
          "warnMax": null,
          "summary": true
        },
        {
          "key": "vyska",
          "label": "Výška",
          "type": "number",
          "unit": "mm",
          "required": true,
          "step": 1,
          "min": null,
          "max": null,
          "warnMin": null,
          "warnMax": null,
          "summary": true
        },
        {
          "key": "barva_profilu",
          "label": "Barva profilu",
          "type": "select",
          "required": true,
          "summary": true,
          "options": [
            { "value": "Bílá 9003", "label": "Bílá 9003", "swatch": "#f4f4f4" },
            { "value": "Hnědá 8019", "label": "Hnědá 8019", "swatch": "#403a3a" },
            { "value": "Sv. hnědá 8003", "label": "Sv. hnědá 8003", "swatch": "#7e4b26" },
            { "value": "Stříbrná 9006", "label": "Stříbrná 9006", "swatch": "#a5a5a5" },
            { "value": "Antracit 7016", "label": "Antracit 7016", "swatch": "#373f43" },
            { "value": "RAL", "label": "RAL" }
          ]
        },
        {
          "key": "ral",
          "label": "RAL",
          "type": "text",
          "required": true,
          "visibleIf": { "field": "barva_profilu", "op": "eq", "value": "RAL" },
          "placeholder": "např. 7035"
        },
        {
          "key": "sitovina",
          "label": "Síťovina",
          "type": "select",
          "required": true,
          "options": [
            { "value": "Standard", "label": "Standard" },
            { "value": "Petscreen", "label": "Petscreen" },
            { "value": "Protipylová", "label": "Protipylová" },
            { "value": "Transparentní", "label": "Transparentní" },
            { "value": "Nano", "label": "Nano" }
          ]
        },
        {
          "key": "barva_sitoviny",
          "label": "Barva síťoviny",
          "type": "select",
          "required": true,
          "options": [
            { "value": "Černá", "label": "Černá", "swatch": "#1a1a1a" },
            { "value": "Šedá", "label": "Šedá", "swatch": "#8c8c8c" }
          ]
        }
      ]
    },
    {
      "key": "prislusenstvi",
      "label": "Příslušenství",
      "fields": [
        {
          "key": "otocne_hacky",
          "label": "Otočné háčky",
          "type": "select",
          "unit": "mm",
          "options": [
            { "value": "0", "label": "0" },
            { "value": "4", "label": "4" },
            { "value": "6", "label": "6" },
            { "value": "7", "label": "7" },
            { "value": "9", "label": "9" },
            { "value": "11", "label": "11" },
            { "value": "12", "label": "12" },
            { "value": "13", "label": "13" },
            { "value": "15", "label": "15" },
            { "value": "17", "label": "17" },
            { "value": "19", "label": "19" },
            { "value": "21", "label": "21" },
            { "value": "23", "label": "23" }
          ]
        },
        {
          "key": "kartacek",
          "label": "Kartáček",
          "type": "select",
          "unit": "mm",
          "options": [
            { "value": "8", "label": "8" },
            { "value": "12", "label": "12" },
            { "value": "18", "label": "18" },
            { "value": "žádný", "label": "žádný" }
          ]
        },
        {
          "key": "typ_uchyceni",
          "label": "Typ uchycení",
          "type": "select",
          "required": true,
          "options": [
            { "value": "STANDARD", "label": "STANDARD" },
            { "value": "ŠTULP S HÁČKEM", "label": "ŠTULP S HÁČKEM" },
            { "value": "ŠTULP BEZ HÁČKU", "label": "ŠTULP BEZ HÁČKU" },
            { "value": "OKAPNICE", "label": "OKAPNICE" },
            { "value": "JINÁ", "label": "JINÁ" }
          ]
        },
        {
          "key": "delka_kartacku",
          "label": "Délka kartáčku",
          "type": "number",
          "unit": "mm/ks",
          "required": true,
          "step": 1,
          "visibleIf": { "field": "kartacek", "op": "in", "values": ["8", "12", "18"] }
        },
        {
          "key": "kartacek_lepeni",
          "label": "Kartáček lepení",
          "type": "select",
          "required": true,
          "visibleIf": { "field": "kartacek", "op": "in", "values": ["8", "12", "18"] },
          "options": [
            { "value": "Ano", "label": "Ano" },
            { "value": "Ne", "label": "Ne" }
          ]
        }
      ]
    },
    {
      "key": "ostatni",
      "label": "Ostatní",
      "fields": [
        {
          "key": "orez_lemu",
          "label": "Ořez lemu sítě",
          "type": "select",
          "options": [
            { "value": "Ano", "label": "Ano" },
            { "value": "Ne", "label": "Ne" }
          ]
        },
        {
          "key": "orez_sirka",
          "label": "Ořez šířka",
          "type": "select",
          "required": true,
          "tbd": true,
          "visibleIf": { "field": "orez_lemu", "op": "eq", "value": "Ano" }
        },
        {
          "key": "orez_vyska",
          "label": "Ořez výška",
          "type": "select",
          "required": true,
          "tbd": true,
          "visibleIf": { "field": "orez_lemu", "op": "eq", "value": "Ano" }
        }
      ]
    }
  ],
  "rules": [
    {
      "type": "minArea",
      "widthField": "sirka",
      "heightField": "vyska",
      "m2": 0.8,
      "if": { "field": "barva_profilu", "op": "neq", "value": "RAL" },
      "level": "info",
      "message": "Plocha je pod minimálním účtovaným rozměrem 0,8 m²."
    },
    {
      "type": "minArea",
      "widthField": "sirka",
      "heightField": "vyska",
      "m2": 2,
      "if": { "field": "barva_profilu", "op": "eq", "value": "RAL" },
      "level": "info",
      "message": "V barvě RAL je minimální účtovaný rozměr 2 m²."
    },
    {
      "type": "requireNote",
      "if": { "field": "orez_lemu", "op": "eq", "value": "Ano" },
      "level": "error",
      "message": "Uveď do poznámky, která strana sítě se ořezává."
    }
  ],
  "printMap": {
    "sirka": "sirka",
    "vyska": "vyska",
    "barva": "barva_profilu",
    "strana": null,
    "ovladani": null
  }
}
